{
  "name": "NVIDIA Learning - RTX 4090",
  "image": "nvcr.io/nvidia/pytorch:24.03-py3",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/nvidia-dli-labs,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/nvidia-dli-labs",
  "runArgs": [
    "--gpus=all",
    "--network=host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}